{
  "name": "gta6-compilations",
  "version": "0.1.0",
  "description": "Provenance-gated compilation pipeline that turns a vetted GTA VI clip registry into youtubeengine-ready jobs.",
  "type": "module",
  "private": true,
  "bin": {
    "gta6": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "audit": "tsx src/cli/index.ts audit",
    "gate": "tsx src/cli/index.ts audit --gate",
    "ingest": "tsx src/cli/index.ts ingest",
    "plan": "tsx src/cli/index.ts plan",
    "job": "tsx src/cli/index.ts job",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
